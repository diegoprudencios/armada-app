{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "^/api/testing-feedback$", "dest": "/api/testing-feedback" },
    { "src": "^/homepage/?$", "dest": "/homepage.html" },
    { "src": "^/homepage[2-5]/?$", "dest": "/homepage.html" },
    { "src": "^/pay-via-link/?$", "dest": "/pay-via-link.html" },
    { "src": "^/dashboard-v2/?$", "dest": "/dashboard.html" },
    { "src": "^/systemdocs/?$", "dest": "/systemdocs.html" },
    { "src": "^/dashboard/?$", "dest": "/dashboard.html" },
    { "src": "^/deposit/?$", "dest": "/dashboard.html" },
    { "src": "^/landing/?$", "dest": "/landing.html" },
    { "src": "^/showcase/?$", "dest": "/landing.html" },
    { "src": "^/$", "dest": "/index.html" }
  ]
}
